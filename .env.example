# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_email_scheduler?schema=public

# Redis Configuration (BullMQ, Rate Limiting, Session store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker & Queue Tuning
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Slack OAuth 2.0
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Security & Secrets
# SESSION_SECRET must be at least 32 characters long
SESSION_SECRET=reachinbox_super_secret_session_key_min_32_chars
# ENCRYPTION_KEY must be a 64-character hex string (32 bytes) for AES-256-GCM token encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Default / Fallback Ethereal SMTP (Senders also store individual SMTP configs in DB)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

