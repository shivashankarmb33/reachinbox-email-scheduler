generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  googleId         String            @unique
  avatar           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  senders          Sender[]
  emails           Email[]
  batches          EmailBatch[]
  slackConnections SlackConnection[]

  @@map("users")
}

model Sender {
  id           String       @id @default(uuid())
  userId       String
  email        String
  smtpHost     String       @default("smtp.ethereal.email")
  smtpPort     Int          @default(587)
  smtpUser     String       @default("")
  smtpPass     String       @default("")
  hourlyLimit  Int          @default(50)
  minimumDelay Int          @default(2000) // in milliseconds (default 2s)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails       Email[]
  batches      EmailBatch[]

  @@unique([userId, email])
  @@index([userId])
  @@map("senders")
}

model Email {
  id                String      @id @default(uuid())
  userId            String
  senderId          String
  batchId           String?
  recipient         String
  subject           String
  body              String
  scheduledAt       DateTime
  sentAt            DateTime?
  status            EmailStatus @default(SCHEDULED)
  providerMessageId String?
  failureReason     String?
  previewUrl        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender            Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  batch             EmailBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([senderId, status])
  @@index([scheduledAt])
  @@index([status])
  @@map("emails")
}

model EmailBatch {
  id              String   @id @default(uuid())
  userId          String
  senderId        String
  subject         String
  body            String
  totalRecipients Int
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender          Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  emails          Email[]

  @@index([userId])
  @@map("email_batches")
}

model SlackConnection {
  id                   String   @id @default(uuid())
  userId               String   @unique
  teamId               String
  channelId            String
  channelName          String?
  encryptedAccessToken String
  connected            Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slack_connections")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String    // e.g., 'EMAIL_SCHEDULED', 'EMAIL_INDEX_SEARCH'
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
  @@map("outbox_events")
}

